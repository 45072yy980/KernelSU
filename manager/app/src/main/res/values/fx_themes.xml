<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="fx_Theme.KernelSU" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="fx_Theme.KernelSU.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fx_splash_bg</item>
        <item name="windowSplashScreenIconBackgroundColor">#00FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/fx_ic_launcher_splash</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/fx_Theme.KernelSU</item>
    </style>

    <style name="fx_Theme.KernelSU.WebUI" parent="fx_Theme.KernelSU">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>
