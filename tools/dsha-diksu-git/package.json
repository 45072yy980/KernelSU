{
  "name": "dsha-diksu-git",
  "description": "Diksu Ultra 专用 git/CI/发布工具（19 个）：仓库自动定位、四层 token 解析 + 设置页入口、提交审计、diff/log/branch/stash/sync/push、CI 编排与 Release 发布",
  "version": "2.2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "Git 仓库",
      "en": "Git"
    },
    "icon": "fork",
    "contributes": {
      "composer.actions": [
        {
          "id": "review",
          "label": {
            "zh": "审改动",
            "en": "Review"
          },
          "icon": "diff",
          "effect": {
            "type": "insert",
            "text": "先用 git_status 和 git_diff 把当前改动过一遍，只看不改；用三条以内说清改了什么、有什么风险。"
          }
        },
        {
          "id": "commit",
          "label": {
            "zh": "提交",
            "en": "Commit"
          },
          "icon": "save",
          "effect": {
            "type": "insert",
            "text": "把当前改动提交上去：先跑 git_audit，再按约定式提交信息写清楚，commit 后告诉我 hash。"
          }
        }
      ],
      "composer.strip": [
        {
          "id": "repo",
          "icon": "fork",
          "panel": "status"
        }
      ],
      "panels": [
        {
          "id": "status",
          "title": {
            "zh": "仓库",
            "en": "Repo"
          },
          "icon": "fork",
          "placement": [
            "session.tab",
            "features"
          ]
        }
      ]
    }
  },
  "license": "MIT",
  "scripts": {
    "test": "node test/run-tests.mjs",
    "test:registry": "node test/smoke-registry.mjs",
    "test:schema": "node test/schema-check.mjs",
    "deploy": "bash scripts/deploy.sh"
  }
}
