{
  "name": "dsha-diksu-git",
  "description": "Diksu Ultra 专用 git/CI/发布工具（19 个）：仓库自动定位、四层 token 解析 + 设置页入口、提交审计、diff/log/branch/stash/sync/push、CI 编排与 Release 发布",
  "version": "2.2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "test": "node test/run-tests.mjs",
    "test:registry": "node test/smoke-registry.mjs",
    "test:schema": "node test/schema-check.mjs",
    "deploy": "bash scripts/deploy.sh"
  }
}
